{
  "name": "partstyle",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @partstyle/viewer build",
    "typecheck": "tsc -p tsconfig.check.json && pnpm --filter @partstyle/viewer check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "partstyle": "node packages/cli/dist/main.js",
    "standalone": "node scripts/standalone.mjs",
    "mcpb": "node scripts/standalone.mjs --mcpb"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
