{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@partstyle/layout": ["../layout/src/index.ts"],
      "@partstyle/layout-cases": ["../cases/src/index.ts"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
